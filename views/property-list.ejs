<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Available Properties | FindMyPG</title>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            background: #f2f4f7;
        }
        .container {
            width: 90%;
            margin: 40px auto;
        }
        h1 {
            text-align: center;
            color: #333;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        .card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: 0.3s ease;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }
        .info {
            padding: 15px;
        }
        .info h3 {
            margin: 0;
            color: #222;
        }
        .info p {
            color: #555;
            margin-top: 5px;
        }
        .rent {
            color: #ff6600;
            font-weight: bold;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Available Properties</h1>
        <div class="grid">
            <% if (properties && properties.length > 0) { %>
                <% properties.forEach(property => { %>
                    <div class="card">
                        <img src="<%= property.image %>" alt="PG Image">
                        <div class="info">
                            <h3><%= property.name %></h3>
                            <p><%= property.address %>, <%= property.city %></p>
                            <p class="rent">₹<%= property.rent %> / month</p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No properties available right now.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
